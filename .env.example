# Database - Use your Supabase PostgreSQL connection
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.mqnibarfktnjncodliba.supabase.co:5432/postgres"

# JWT Secret (generate a secure random string)
JWT_SECRET="your-super-secure-jwt-secret-key-here"

# Google Gemini API Key for AI Chatbot
NEXT_PUBLIC_GEMINI_API_KEY="your-gemini-api-key-here"
NEXT_PUBLIC_GEMINI_MODEL="gemini-2.0-flash-exp"

# Sarvam AI Configuration (Indian AI model with Hindi support)
NEXT_PUBLIC_SARVAM_API_KEY="your-sarvam-api-key-here"
NEXT_PUBLIC_SARVAM_MODEL="sarvam-2b"
NEXT_PUBLIC_SARVAM_ENDPOINT="https://api.sarvam.ai/v1/chat/completions"

# AI Provider Selection (gemini | sarvam | openai | claude)
NEXT_PUBLIC_AI_PROVIDER="gemini"

# Application Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email Settings (for invite notifications)
EMAIL_FROM="noreply@yourapp.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# Security Settings
INVITE_TOKEN_EXPIRY_HOURS="72"
PASSWORD_MIN_LENGTH="8"

# Redis (optional - for caching)
REDIS_URL="redis://localhost:6379"
# AWS DynamoDB Configuration for Chat Memory
# Note: These use NEXT_PUBLIC_ prefix to avoid conflicts with reserved environment variables
# When deploying to Vercel/Netlify/AWS, use these exact names (not AWS_REGION, etc.)
NEXT_PUBLIC_AWS_REGION="ap-south-1"
NEXT_PUBLIC_AWS_ACCESS_KEY_ID="your-aws-access-key-id"
NEXT_PUBLIC_AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
NEXT_PUBLIC_DYNAMODB_TABLE="chatbot-ai"

