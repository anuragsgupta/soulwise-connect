model ChatMessage {
  id             String      @id @default(uuid())
  senderType     SenderType  @map("sender_type")
  content        String
  sentimentScore Decimal?    @map("sentiment_score") @db.Decimal(3, 2)
  crisisKeywords Json?       @map("crisis_keywords") // Array
  timestamp      DateTime    @default(now())

  // Relations
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String      @map("session_id")

  @@map("chat_messages")
}

// ==================== SYSTEM TABLES ====================

model Invite {
  id            String      @id @default(uuid())
  email         String
  token         String      @unique
  userType      UserType    @map("user_type")
  roleType      String      @map("role_type") // UNIVERSITY_ADMIN, INSTITUTE_ADMIN, FACULTY, etc.
  expiresAt     DateTime    @map("expires_at")
  acceptedAt    DateTime?   @map("accepted_at")
  status        InviteStatus @default(PENDING)
  createdAt     DateTime    @default(now()) @map("created_at")

  // Relations - who created this invite
  createdByAdmin   Admin?   @relation("InviteCreator", fields: [createdByAdminId], references: [id])
  createdByAdminId String?  @map("created_by_admin_id")
  createdByFaculty Faculty? @relation("FacultyInviteCreator", fields: [createdByFacultyId], references: [id])
  createdByFacultyId String? @map("created_by_faculty_id")

  // Context relations
  university   University? @relation(fields: [universityId], references: [id])
  universityId String?     @map("university_id")
  institute    Institute?  @relation(fields: [instituteId], references: [id])
  instituteId  String?     @map("institute_id")
  department   Department? @relation(fields: [departmentId], references: [id])
  departmentId String?     @map("department_id")

  @@map("invites")
}

model Session {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  userType  UserType  @map("user_type")
  token     String    @unique
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")
  expiresAt DateTime  @map("expires_at")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")

  // Polymorphic relations
  admin    Admin?   @relation(fields: [adminId], references: [id])
  adminId  String?  @map("admin_id")
  faculty  Faculty? @relation(fields: [facultyId], references: [id])
  facultyId String? @map("faculty_id")
  student  Student? @relation(fields: [studentId], references: [id])
  studentId String? @map("student_id")

  @@index([token])
  @@index([userId, userType])
  @@index([expiresAt])
  @@map("sessions")
}

