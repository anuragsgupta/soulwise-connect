// ==================== FACULTY SYSTEM ====================

model Faculty {
  id                  String         @id @default(uuid())
  name                String
  email               String         @unique
  passwordHash        String         @map("password_hash")
  phone               String?
  address             String?
  jobTitle            String?        @map("job_title") // Professor, Assistant Professor, etc.
  facultyType         FacultyType    @map("faculty_type")
  status              FacultyStatus  @default(ACTIVE)
  availabilityStatus  AvailabilityStatus @default(AVAILABLE) @map("availability_status")
  yearsOfExperience   Int?           @map("years_of_experience")
  panNumber           String?        @map("pan_number")
  aadhaarNumber       String?        @map("aadhaar_number")
  lastLogin           DateTime?      @map("last_login")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  // Relations
  department          Department     @relation("DepartmentFaculty", fields: [departmentId], references: [id])
  departmentId        String         @map("department_id")
  institute           Institute      @relation("InstituteFaculty", fields: [instituteId], references: [id])
  instituteId         String         @map("institute_id")
  university          University     @relation(fields: [universityId], references: [id])
  universityId        String         @map("university_id")
  mentorSupervisor    Faculty?       @relation("MentorSupervisor", fields: [mentorSupervisorId], references: [id])
  mentorSupervisorId  String?        @map("mentor_supervisor_id")

  // Inverse relations
  mentoredFaculty     Faculty[]      @relation("MentorSupervisor")
  mentoredStudents    Student[]
  hodOfInstitutes     Institute[]    @relation("InstituteHOD")
  hodOfDepartments    Department[]   @relation("DepartmentHOD")
  createdInvites      Invite[]       @relation("FacultyInviteCreator")
  crisisAlerts        CrisisAlert[]
  auditLogs           AuditLog[]     @relation("FacultyAuditLogs")
  sessions            Session[]

  @@index([email])
  @@index([instituteId])
  @@index([departmentId])
  @@index([facultyType])
  @@index([status])
  @@map("faculty")
}

// ==================== STUDENT SYSTEM ====================

model Student {
  id                    String        @id @default(uuid())
  name                  String
  email                 String        @unique
  passwordHash          String        @map("password_hash")
  enrollmentId          String        @unique @map("enrollment_id") // Primary login identifier
  rollNumber            String?       @map("roll_number")
  phone                 String?
  parentPhone           String?       @map("parent_phone")
  emergencyContactName  String?       @map("emergency_contact_name")
  emergencyContactPhone String?       @map("emergency_contact_phone")
  currentSemester       Int           @map("current_semester")
  cgpa                  Decimal?      @db.Decimal(3, 2)
  admissionYear         Int           @map("admission_year")
  status                StudentStatus @default(ACTIVE)
  lastLogin             DateTime?     @map("last_login")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  // Relations
  university   University  @relation(fields: [universityId], references: [id])
  universityId String      @map("university_id")
  institute    Institute   @relation(fields: [instituteId], references: [id])
  instituteId  String      @map("institute_id")
  department   Department  @relation(fields: [departmentId], references: [id])
  departmentId String      @map("department_id")
  batch        Batch       @relation(fields: [batchId], references: [id])
  batchId      String      @map("batch_id")
  mentor       Faculty?    @relation(fields: [mentorId], references: [id])
  mentorId     String?     @map("mentor_id")

  // Inverse relations
  locations     Location[]
  moodCheckIns  MoodCheckIn[]
  crisisAlerts  CrisisAlert[]
  chatSessions  ChatSession[]
  auditLogs     AuditLog[]    @relation("StudentAuditLogs")
  sessions      Session[]

  @@index([email])
  @@index([enrollmentId])
  @@index([rollNumber])
  @@index([instituteId])
  @@index([departmentId])
  @@index([mentorId])
  @@index([status])
  @@map("students")
}

