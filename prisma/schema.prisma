// This is your Prisma schema file
// Updated to match the new admin-centric architecture
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ADMIN SYSTEM ====================

model Admin {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  passwordHash String      @map("password_hash")
  phone        String?
  address      String?
  adminType    AdminType   @map("admin_type")
  status       AdminStatus @default(ACTIVE)
  isSuperAdmin Boolean     @default(false) @map("is_super_admin") // Flag for default super admin
  lastLogin    DateTime?   @map("last_login")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  // Relations
  university   University? @relation(fields: [universityId], references: [id])
  universityId String?     @map("university_id")
  institute    Institute?  @relation(fields: [instituteId], references: [id])
  instituteId  String?     @map("institute_id")

  // Inverse relations
  createdInvites Invite[]    @relation("InviteCreator")
  auditLogs      AuditLog[]  @relation("AdminAuditLogs")
  sessions       Session[]

  @@index([email])
  @@index([adminType, status])
  @@index([universityId])
  @@index([instituteId])
  @@map("admins")
}

