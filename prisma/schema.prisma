generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model admins {
  id             String          @id
  name           String
  email          String          @unique
  password_hash  String
  phone          String?
  address        String?
  admin_type     AdminType
  status         AdminStatus     @default(ACTIVE)
  is_super_admin Boolean         @default(false)
  last_login     DateTime?
  created_at     DateTime        @default(now())
  updated_at     DateTime
  university_id  String?
  institute_id   String?
  institutes     institutes?     @relation(fields: [institute_id], references: [id])
  universities   universities?   @relation(fields: [university_id], references: [id])
  audit_logs     audit_logs[]
  invites        invites[]
  notifications  notifications[]
  sessions       sessions[]

  @@index([admin_type, status])
  @@index([email])
  @@index([institute_id])
  @@index([university_id])
}

model audit_logs {
  id                String        @id
  performed_by_id   String
  performed_by_type UserType
  action            AuditAction
  table_name        String
  record_id         String
  old_values        Json?
  new_values        Json?
  ip_address        String?
  timestamp         DateTime      @default(now())
  admin_id          String?
  faculty_id        String?
  student_id        String?
  university_id     String?
  institute_id      String?
  department_id     String?
  admins            admins?       @relation(fields: [admin_id], references: [id])
  departments       departments?  @relation(fields: [department_id], references: [id])
  faculty           faculty?      @relation(fields: [faculty_id], references: [id])
  institutes        institutes?   @relation(fields: [institute_id], references: [id])
  students          students?     @relation(fields: [student_id], references: [id])
  universities      universities? @relation(fields: [university_id], references: [id])

  @@index([performed_by_id, performed_by_type])
  @@index([timestamp])
}

model batches {
  id               String      @id
  name             String
  start_year       Int
  end_year         Int
  current_semester Int
  created_at       DateTime    @default(now())
  updated_at       DateTime
  department_id    String
  departments      departments @relation(fields: [department_id], references: [id], onDelete: Cascade)
  students         students[]
}

model chat_messages {
  id              String        @id
  sender_type     SenderType
  content         String
  sentiment_score Decimal?      @db.Decimal(3, 2)
  crisis_keywords Json?
  timestamp       DateTime      @default(now())
  session_id      String
  chat_sessions   chat_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade)
}

model chat_sessions {
  id              String          @id
  session_start   DateTime
  session_end     DateTime?
  message_count   Int             @default(0)
  crisis_detected Boolean         @default(false)
  sentiment_score Decimal?        @db.Decimal(3, 2)
  created_at      DateTime        @default(now())
  student_id      String
  chat_messages   chat_messages[]
  students        students        @relation(fields: [student_id], references: [id], onDelete: Cascade)
}

model crisis_alerts {
  id               String         @id
  severity         CrisisSeverity
  trigger_source   TriggerSource
  trigger_message  String?
  ai_analysis      String?
  keywords         Json?
  status           CrisisStatus   @default(OPEN)
  acknowledged_at  DateTime?
  resolved_at      DateTime?
  resolution_notes String?
  created_at       DateTime       @default(now())
  updated_at       DateTime
  student_id       String
  assigned_to_id   String?
  faculty          faculty?       @relation(fields: [assigned_to_id], references: [id])
  students         students       @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([created_at])
  @@index([severity, status])
  @@index([student_id, status])
}

model departments {
  id                                         String       @id
  name                                       String
  code                                       String
  created_at                                 DateTime     @default(now())
  updated_at                                 DateTime
  institute_id                               String
  hod_id                                     String?
  audit_logs                                 audit_logs[]
  batches                                    batches[]
  faculty_departments_hod_idTofaculty        faculty?     @relation("departments_hod_idTofaculty", fields: [hod_id], references: [id])
  institutes                                 institutes   @relation(fields: [institute_id], references: [id], onDelete: Cascade)
  faculty_faculty_department_idTodepartments faculty[]    @relation("faculty_department_idTodepartments")
  invites                                    invites[]
  students                                   students[]

  @@unique([code, institute_id])
  @@index([code])
  @@index([institute_id])
}

model diary_entries {
  id         String   @id
  title      String
  content    String
  mood       String
  tags       Json?
  word_count Int      @default(0)
  char_count Int      @default(0)
  entry_date DateTime @default(now())
  created_at DateTime @default(now())
  updated_at DateTime
  student_id String
  students   students @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([entry_date])
  @@index([student_id, entry_date])
}

model faculty {
  id                                             String             @id
  name                                           String
  email                                          String             @unique
  password_hash                                  String
  phone                                          String?
  address                                        String?
  job_title                                      String?
  faculty_type                                   FacultyType
  status                                         FacultyStatus      @default(ACTIVE)
  availability_status                            AvailabilityStatus @default(AVAILABLE)
  years_of_experience                            Int?
  pan_number                                     String?
  aadhaar_number                                 String?
  last_login                                     DateTime?
  created_at                                     DateTime           @default(now())
  updated_at                                     DateTime
  department_id                                  String
  institute_id                                   String
  university_id                                  String
  mentor_supervisor_id                           String?
  audit_logs                                     audit_logs[]
  crisis_alerts                                  crisis_alerts[]
  departments_departments_hod_idTofaculty        departments[]      @relation("departments_hod_idTofaculty")
  departments_faculty_department_idTodepartments departments        @relation("faculty_department_idTodepartments", fields: [department_id], references: [id])
  institutes_faculty_institute_idToinstitutes    institutes         @relation("faculty_institute_idToinstitutes", fields: [institute_id], references: [id])
  faculty                                        faculty?           @relation("facultyTofaculty", fields: [mentor_supervisor_id], references: [id])
  other_faculty                                  faculty[]          @relation("facultyTofaculty")
  universities                                   universities       @relation(fields: [university_id], references: [id])
  institutes_institutes_hod_idTofaculty          institutes[]       @relation("institutes_hod_idTofaculty")
  invites                                        invites[]
  notifications                                  notifications[]
  session_bookings                               session_bookings[]
  sessions                                       sessions[]
  students                                       students[]

  @@index([department_id])
  @@index([email])
  @@index([faculty_type])
  @@index([institute_id])
  @@index([status])
}

model fields {
  id          String       @id
  name        String
  description String?
  created_at  DateTime     @default(now())
  updated_at  DateTime
  institutes  institutes[]
}

model gad7_surveys {
  id           String       @id
  completed_at DateTime     @default(now())
  q1_nervous   Int
  q2_control   Int
  q3_worrying  Int
  q4_relaxing  Int
  q5_restless  Int
  q6_irritable Int
  q7_afraid    Int
  total_score  Int
  severity     GAD7Severity
  student_id   String
  students     students     @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([student_id, completed_at])
}

model institutes {
  id                                       String          @id
  code                                     String          @unique
  name                                     String
  email                                    String          @unique
  phone                                    String
  address                                  String
  status                                   InstituteStatus @default(ACTIVE)
  created_at                               DateTime        @default(now())
  updated_at                               DateTime
  university_id                            String
  field_id                                 String?
  hod_id                                   String?
  aishe_code                               String?         @unique
  admins                                   admins[]
  audit_logs                               audit_logs[]
  departments                              departments[]
  faculty_faculty_institute_idToinstitutes faculty[]       @relation("faculty_institute_idToinstitutes")
  fields                                   fields?         @relation(fields: [field_id], references: [id])
  faculty_institutes_hod_idTofaculty       faculty?        @relation("institutes_hod_idTofaculty", fields: [hod_id], references: [id])
  universities                             universities    @relation(fields: [university_id], references: [id], onDelete: Cascade)
  invites                                  invites[]
  students                                 students[]

  @@index([code])
  @@index([status])
  @@index([university_id])
}

model invites {
  id                    String        @id
  email                 String
  token                 String        @unique
  user_type             UserType
  role_type             String
  expires_at            DateTime
  accepted_at           DateTime?
  status                InviteStatus  @default(PENDING)
  created_at            DateTime      @default(now())
  created_by_admin_id   String?
  created_by_faculty_id String?
  university_id         String?
  institute_id          String?
  department_id         String?
  admins                admins?       @relation(fields: [created_by_admin_id], references: [id])
  faculty               faculty?      @relation(fields: [created_by_faculty_id], references: [id])
  departments           departments?  @relation(fields: [department_id], references: [id])
  institutes            institutes?   @relation(fields: [institute_id], references: [id])
  universities          universities? @relation(fields: [university_id], references: [id])
}

model locations {
  id               String       @id
  address          String?
  city             String?
  state            String?
  pincode          String?
  home_latitude    Decimal?     @db.Decimal(10, 8)
  home_longitude   Decimal?     @db.Decimal(11, 8)
  recent_latitude  Decimal?     @db.Decimal(10, 8)
  recent_longitude Decimal?     @db.Decimal(11, 8)
  recent_address   String?
  location_type    LocationType
  last_updated     DateTime
  created_at       DateTime     @default(now())
  updated_at       DateTime
  student_id       String
  students         students     @relation(fields: [student_id], references: [id], onDelete: Cascade)
}

model mood_check_ins {
  id            String   @id
  mood_score    Int
  mood_label    String
  factors       Json?
  notes         String?
  check_in_date DateTime @db.Date
  created_at    DateTime @default(now())
  student_id    String
  students      students @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([check_in_date])
  @@index([student_id, check_in_date])
}

model notifications {
  id                   String            @id
  title                String
  message              String
  type                 NotificationType
  is_read              Boolean           @default(false)
  related_id           String?
  related_type         String?
  action_url           String?
  recipient_type       UserType
  created_at           DateTime          @default(now())
  read_at              DateTime?
  student_recipient_id String?
  faculty_recipient_id String?
  admin_recipient_id   String?
  session_booking_id   String?
  admins               admins?           @relation(fields: [admin_recipient_id], references: [id], onDelete: Cascade)
  faculty              faculty?          @relation(fields: [faculty_recipient_id], references: [id], onDelete: Cascade)
  session_bookings     session_bookings? @relation(fields: [session_booking_id], references: [id], onDelete: Cascade)
  students             students?         @relation(fields: [student_recipient_id], references: [id], onDelete: Cascade)

  @@index([admin_recipient_id, is_read])
  @@index([created_at])
  @@index([faculty_recipient_id, is_read])
  @@index([recipient_type, is_read])
  @@index([student_recipient_id, is_read])
}

model phq9_surveys {
  id               String       @id
  completed_at     DateTime     @default(now())
  q1_interest      Int
  q2_depressed     Int
  q3_sleep         Int
  q4_energy        Int
  q5_appetite      Int
  q6_failure       Int
  q7_concentration Int
  q8_movement      Int
  q9_harm          Int
  total_score      Int
  severity         PHQ9Severity
  student_id       String
  students         students     @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([student_id, completed_at])
}

model session_bookings {
  id               String          @id
  session_type     SessionType
  title            String
  description      String?
  scheduled_date   DateTime
  scheduled_time   String
  duration         Int             @default(30)
  status           SessionStatus   @default(PENDING)
  meeting_link     String?
  location         String?
  student_notes    String?
  faculty_notes    String?
  rejection_reason String?
  approved_at      DateTime?
  rejected_at      DateTime?
  completed_at     DateTime?
  created_at       DateTime        @default(now())
  updated_at       DateTime
  student_id       String
  faculty_id       String
  google_event_id  String?
  notifications    notifications[]
  faculty          faculty         @relation(fields: [faculty_id], references: [id], onDelete: Cascade)
  students         students        @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([created_at])
  @@index([faculty_id, status])
  @@index([scheduled_date, status])
  @@index([student_id, status])
}

model sessions {
  id         String    @id
  user_id    String
  user_type  UserType
  token      String    @unique
  ip_address String?
  user_agent String?
  expires_at DateTime
  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  admin_id   String?
  faculty_id String?
  student_id String?
  admins     admins?   @relation(fields: [admin_id], references: [id])
  faculty    faculty?  @relation(fields: [faculty_id], references: [id])
  students   students? @relation(fields: [student_id], references: [id])

  @@index([expires_at])
  @@index([token])
  @@index([user_id, user_type])
}

model students {
  id                      String             @id
  name                    String
  email                   String             @unique
  password_hash           String
  enrollment_id           String             @unique
  roll_number             String?
  phone                   String?
  parent_phone            String?
  emergency_contact_name  String?
  emergency_contact_phone String?
  current_semester        Int
  cgpa                    Decimal?           @db.Decimal(3, 2)
  admission_year          Int
  status                  StudentStatus      @default(ACTIVE)
  last_login              DateTime?
  created_at              DateTime           @default(now())
  updated_at              DateTime
  university_id           String
  institute_id            String
  department_id           String
  batch_id                String
  mentor_id               String?
  gemini_api_key          String?
  audit_logs              audit_logs[]
  chat_sessions           chat_sessions[]
  crisis_alerts           crisis_alerts[]
  diary_entries           diary_entries[]
  gad7_surveys            gad7_surveys[]
  locations               locations[]
  mood_check_ins          mood_check_ins[]
  notifications           notifications[]
  phq9_surveys            phq9_surveys[]
  session_bookings        session_bookings[]
  sessions                sessions[]
  batches                 batches            @relation(fields: [batch_id], references: [id])
  departments             departments        @relation(fields: [department_id], references: [id])
  institutes              institutes         @relation(fields: [institute_id], references: [id])
  faculty                 faculty?           @relation(fields: [mentor_id], references: [id])
  universities            universities       @relation(fields: [university_id], references: [id])
  tasks                   tasks[]

  @@index([department_id])
  @@index([email])
  @@index([enrollment_id])
  @@index([institute_id])
  @@index([mentor_id])
  @@index([roll_number])
  @@index([status])
}

model tasks {
  id           String    @id
  title        String
  description  String?
  priority     String
  category     String
  status       String
  due_date     DateTime?
  completed    Boolean   @default(false)
  completed_at DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime
  student_id   String
  students     students  @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([student_id, completed])
  @@index([student_id, due_date])
}

model universities {
  id                 String           @id
  name               String
  email              String           @unique
  domain             String           @unique
  phone              String
  address            String
  city               String
  state              String
  status             UniversityStatus @default(ACTIVE)
  created_at         DateTime         @default(now())
  updated_at         DateTime
  aishe_code         String?          @unique
  contact_first_name String?
  contact_last_name  String?
  district           String?
  admins             admins[]
  audit_logs         audit_logs[]
  faculty            faculty[]
  institutes         institutes[]
  invites            invites[]
  students           students[]

  @@index([domain])
  @@index([status])
}

enum AdminStatus {
  ACTIVE
  SUSPENDED
  PENDING_APPROVAL
}

enum AdminType {
  SUPER_ADMIN
  UNIVERSITY_ADMIN
  INSTITUTE_ADMIN
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PASSWORD_CHANGE
}

enum AvailabilityStatus {
  AVAILABLE
  BUSY
  OFFLINE
}

enum CrisisSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CrisisStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  FALSE_ALARM
}

enum FacultyStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  INACTIVE
}

enum FacultyType {
  HOD
  MENTOR_SUPERVISOR
  MENTOR
  FACULTY
  COUNSELOR
}

enum GAD7Severity {
  MINIMAL
  MILD
  MODERATE
  SEVERE
}

enum InstituteStatus {
  ACTIVE
  INACTIVE
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum LocationType {
  HOME
  CAMPUS
  OTHER
}

enum NotificationType {
  SESSION_REQUEST
  SESSION_APPROVED
  SESSION_REJECTED
  SESSION_RESCHEDULED
  SESSION_REMINDER
  SESSION_CANCELLED
  SESSION_COMPLETED
  CRISIS_ALERT
  GENERAL
}

enum PHQ9Severity {
  NONE
  MILD
  MODERATE
  MODERATELY_SEVERE
  SEVERE
}

enum SenderType {
  STUDENT
  BOT
}

enum SessionStatus {
  PENDING
  APPROVED
  REJECTED
  RESCHEDULED
  COMPLETED
  CANCELLED
}

enum SessionType {
  COUNSELING
  MENTORING
  ACADEMIC
  CAREER_GUIDANCE
  PERSONAL
  OTHER
}

enum StudentStatus {
  ACTIVE
  SUSPENDED
  GRADUATED
  DROPPED_OUT
}

enum TriggerSource {
  CHAT
  MOOD_TRACKER
  MANUAL
  SYSTEM
}

enum UniversityStatus {
  ACTIVE
  INACTIVE
}

enum UserType {
  ADMIN
  FACULTY
  STUDENT
}